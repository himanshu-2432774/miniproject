{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "css/*", "use": "@vercel/static" },
    { "src": "js/*", "use": "@vercel/static" },
    { "src": "images/*", "use": "@vercel/static" }
  ]
  ,
  "routes": [
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/about$", "dest": "/about.html" },
    { "src": "^/volunteer$", "dest": "/volunteer.html" },
    { "handle": "filesystem" },
    { "src": "^/(.*)$", "dest": "/$1" }
  ]
}
